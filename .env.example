# ════════════════════════════════════════════════════════
# CelerySync — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit your real .env file to git
# ════════════════════════════════════════════════════════

# ── Anthropic Claude API (server-side only)
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase
# Get from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# ── Stripe
# Get from: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_ANNUAL_PRICE_ID=price_...

# ── ElevenLabs (server-side only)
# Get from: elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=sk_...

# ── Stripe publishable key (client-side — safe to expose)
# Get from: dashboard.stripe.com → Developers → API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── VAPID keys for Web Push Notifications (server-side)
# Generate with: node -e "import('web-push').then(m => { const k = m.default.generateVAPIDKeys(); console.log(JSON.stringify(k)); })"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── VAPID public key (client-side — safe to expose)
# Same value as VAPID_PUBLIC_KEY above
VITE_VAPID_PUBLIC_KEY=

# ── App URLs (update for production)
# Dev: http://localhost:5173
# Production: https://celerysync.com
CLIENT_URL=http://localhost:5173
PORT=3001

# ── API URL (client-side — points to the backend server)
# Dev: http://localhost:3001
# Production: https://your-railway-app.railway.app
VITE_API_URL=http://localhost:3001

# ── Admin
ADMIN_EMAIL=admin@example.com

# ── Stripe practitioner plan (create $49/month price in Stripe dashboard)
STRIPE_PRACTITIONER_PRICE_ID=price_...


# ════════════════════════════════════════════════════════
# STEP 1 — SUPABASE SETUP
# Run this SQL in: supabase.com → your project → SQL Editor
# ════════════════════════════════════════════════════════
#
# create table public.subscriptions (
#   user_id uuid references auth.users(id) on delete cascade primary key,
#   stripe_customer_id text,
#   stripe_subscription_id text,
#   status text not null default 'inactive',
#   current_period_end timestamptz,
#   updated_at timestamptz not null default now()
# );
#
# alter table public.subscriptions enable row level security;
#
# create policy "Users can view own subscription"
#   on public.subscriptions for select
#   using (auth.uid() = user_id);
#
# In Supabase → Authentication → URL Configuration:
#   Site URL: http://localhost:5173
#   Redirect URLs: http://localhost:5173/**


# ════════════════════════════════════════════════════════
# STEP 2 — STRIPE SETUP
# ════════════════════════════════════════════════════════
#
# 1. Create Product: "CelerySync Healer Plan"
# 2. Add Price: $9.97 AUD recurring monthly → copy Price ID above
# 3. Webhook endpoint: YOUR_SERVER_URL/api/stripe/webhook
#    Events: checkout.session.completed, customer.subscription.updated,
#            customer.subscription.deleted, invoice.payment_failed
# 4. Local testing: stripe listen --forward-to localhost:3001/api/stripe/webhook
# 5. Enable Customer Portal: dashboard.stripe.com → Settings → Billing → Customer portal
